<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neuedu.system.mapper.UserFootprintMapper">
    
    <resultMap type="UserFootprint" id="UserFootprintResult">
        <result property="id"    column="id"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createUser"    column="create_user"    />
        <result property="updateUser"    column="update_user"    />
        <result property="deleteFlag"    column="delete_flag"    />
        <result property="userId"    column="user_id"    />
        <result property="targetType"    column="target_type"    />
        <result property="targetId"    column="target_id"    />
        <result property="targetName"    column="target_name"    />
        <result property="targetImage"    column="target_image"    />
        <result property="price"    column="price"    />
        <result property="categoryId"    column="category_id"    />
        <result property="categoryName"    column="category_name"    />
        <result property="browseCount"    column="browse_count"    />
        <result property="lastBrowseTime"    column="last_browse_time"    />
    </resultMap>

    <sql id="selectUserFootprintVo">
        select id, create_time, update_time, create_user, update_user, delete_flag, user_id, target_type, target_id, target_name, target_image, price, category_id, category_name, browse_count, last_browse_time from user_footprint
    </sql>

    <select id="selectUserFootprintList" parameterType="UserFootprint" resultMap="UserFootprintResult">
        <include refid="selectUserFootprintVo"/>
        <where>  
            <if test="createUser != null "> and create_user = #{createUser}</if>
            <if test="updateUser != null "> and update_user = #{updateUser}</if>
            <if test="deleteFlag != null "> and delete_flag = #{deleteFlag}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="targetType != null "> and target_type = #{targetType}</if>
            <if test="targetId != null "> and target_id = #{targetId}</if>
            <if test="targetName != null  and targetName != ''"> and target_name like concat('%', #{targetName}, '%')</if>
            <if test="targetImage != null  and targetImage != ''"> and target_image = #{targetImage}</if>
            <if test="price != null "> and price = #{price}</if>
            <if test="categoryId != null "> and category_id = #{categoryId}</if>
            <if test="categoryName != null  and categoryName != ''"> and category_name like concat('%', #{categoryName}, '%')</if>
            <if test="browseCount != null "> and browse_count = #{browseCount}</if>
            <if test="lastBrowseTime != null "> and last_browse_time = #{lastBrowseTime}</if>
        </where>
        order by last_browse_time desc
    </select>
    
    <select id="selectUserFootprintById" parameterType="Long" resultMap="UserFootprintResult">
        <include refid="selectUserFootprintVo"/>
        where user_footprint.id = #{id}
    </select>

    <!-- 新增的查询方法 -->
    <select id="selectFootprintByUserAndTarget" resultMap="UserFootprintResult">
        <include refid="selectUserFootprintVo"/>
        where user_id = #{userId} and target_type = #{targetType} and target_id = #{targetId} and delete_flag = 0
        limit 1
    </select>

    <select id="selectFootprintByUserId" parameterType="Long" resultMap="UserFootprintResult">
        <include refid="selectUserFootprintVo"/>
        where user_id = #{userId} and delete_flag = 0
        order by last_browse_time desc
    </select>

    <select id="selectRecentFootprint" resultMap="UserFootprintResult">
        <include refid="selectUserFootprintVo"/>
        where user_id = #{userId} and delete_flag = 0
        order by last_browse_time desc
        <if test="limit != null">limit #{limit}</if>
    </select>

    <select id="countUserFootprint" parameterType="Long" resultType="int">
        select count(*) from user_footprint
        where user_id = #{userId} and delete_flag = 0
    </select>
        
    <insert id="insertUserFootprint" parameterType="UserFootprint" useGeneratedKeys="true" keyProperty="id">
        insert into user_footprint
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createUser != null">create_user,</if>
            <if test="updateUser != null">update_user,</if>
            <if test="deleteFlag != null">delete_flag,</if>
            <if test="userId != null">user_id,</if>
            <if test="targetType != null">target_type,</if>
            <if test="targetId != null">target_id,</if>
            <if test="targetName != null and targetName != ''">target_name,</if>
            <if test="targetImage != null">target_image,</if>
            <if test="price != null">price,</if>
            <if test="categoryId != null">category_id,</if>
            <if test="categoryName != null">category_name,</if>
            <if test="browseCount != null">browse_count,</if>
            <if test="lastBrowseTime != null">last_browse_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createUser != null">#{createUser},</if>
            <if test="updateUser != null">#{updateUser},</if>
            <if test="deleteFlag != null">#{deleteFlag},</if>
            <if test="userId != null">#{userId},</if>
            <if test="targetType != null">#{targetType},</if>
            <if test="targetId != null">#{targetId},</if>
            <if test="targetName != null and targetName != ''">#{targetName},</if>
            <if test="targetImage != null">#{targetImage},</if>
            <if test="price != null">#{price},</if>
            <if test="categoryId != null">#{categoryId},</if>
            <if test="categoryName != null">#{categoryName},</if>
            <if test="browseCount != null">#{browseCount},</if>
            <if test="lastBrowseTime != null">#{lastBrowseTime},</if>
         </trim>
    </insert>

    <update id="updateUserFootprint" parameterType="UserFootprint">
        update user_footprint
        <trim prefix="SET" suffixOverrides=",">
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createUser != null">create_user = #{createUser},</if>
            <if test="updateUser != null">update_user = #{updateUser},</if>
            <if test="deleteFlag != null">delete_flag = #{deleteFlag},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="targetType != null">target_type = #{targetType},</if>
            <if test="targetId != null">target_id = #{targetId},</if>
            <if test="targetName != null and targetName != ''">target_name = #{targetName},</if>
            <if test="targetImage != null">target_image = #{targetImage},</if>
            <if test="price != null">price = #{price},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="categoryName != null">category_name = #{categoryName},</if>
            <if test="browseCount != null">browse_count = #{browseCount},</if>
            <if test="lastBrowseTime != null">last_browse_time = #{lastBrowseTime},</if>
        </trim>
        where user_footprint.id = #{id}
    </update>

    <delete id="deleteUserFootprintById" parameterType="Long">
        delete from user_footprint where id = #{id}
    </delete>

    <delete id="deleteUserFootprintByIds" parameterType="String">
        delete from user_footprint where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>


    <!-- 更新浏览信息 -->
    <update id="updateBrowseInfo">
        update user_footprint
        set browse_count = #{browseCount},
            last_browse_time = #{lastBrowseTime},
            update_time = now()
        where id = #{id}
    </update>

    <!-- 清空用户足迹（逻辑删除） -->
    <update id="clearUserFootprint" parameterType="Long">
        update user_footprint
        set delete_flag = 1,
            update_time = now()
        where user_id = #{userId} and delete_flag = 0
    </update>

    <!-- 删除指定目标的足迹（逻辑删除） -->
    <update id="deleteSpecificFootprint">
        update user_footprint
        set delete_flag = 1,
            update_time = now()
        where user_id = #{userId}
          and target_type = #{targetType}
          and target_id = #{targetId}
          and delete_flag = 0
    </update>
</mapper>