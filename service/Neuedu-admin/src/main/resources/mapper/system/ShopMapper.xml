<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neuedu.system.mapper.ShopMapper">

    <resultMap type="Shop" id="ShopResult">
        <result property="id"    column="id"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createUser"    column="create_user"    />
        <result property="updateUser"    column="update_user"    />
        <result property="deleteFlag"    column="delete_flag"    />
        <result property="userId"    column="user_id"    />
        <result property="shopName"    column="shop_name"    />
        <result property="shopLogo"    column="shop_logo"    />
        <result property="shopBanner"    column="shop_banner"    />
        <result property="description"    column="description"    />
        <result property="contactPhone"    column="contact_phone"    />
        <result property="contactAddress"    column="contact_address"    />
        <result property="shopScore"    column="shop_score"    />
        <result property="salesCount"    column="sales_count"    />
        <result property="productCount"    column="product_count"    />
        <result property="followerCount"    column="follower_count"    />
        <result property="status"    column="status"    />
    </resultMap>

    <sql id="selectShopVo">
        select id, create_time, update_time, create_user, update_user, delete_flag, user_id, shop_name, shop_logo, shop_banner, description, contact_phone, contact_address, shop_score, sales_count, product_count, follower_count, status from shop
    </sql>

    <select id="selectShopList" parameterType="Shop" resultMap="ShopResult">
        <include refid="selectShopVo"/>
        <where>
            <if test="createUser != null "> and create_user = #{createUser}</if>
            <if test="updateUser != null "> and update_user = #{updateUser}</if>
            <if test="deleteFlag != null "> and delete_flag = #{deleteFlag}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="shopName != null  and shopName != ''"> and shop_name like concat('%', #{shopName}, '%')</if>
            <if test="shopLogo != null  and shopLogo != ''"> and shop_logo = #{shopLogo}</if>
            <if test="shopBanner != null  and shopBanner != ''"> and shop_banner = #{shopBanner}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="contactPhone != null  and contactPhone != ''"> and contact_phone = #{contactPhone}</if>
            <if test="contactAddress != null  and contactAddress != ''"> and contact_address = #{contactAddress}</if>
            <if test="shopScore != null "> and shop_score = #{shopScore}</if>
            <if test="salesCount != null "> and sales_count = #{salesCount}</if>
            <if test="productCount != null "> and product_count = #{productCount}</if>
            <if test="followerCount != null "> and follower_count = #{followerCount}</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
    </select>

    <select id="selectShopById" parameterType="Long" resultMap="ShopResult">
        <include refid="selectShopVo"/>
        where shop.id = #{id}
    </select>

    <!-- 新增：根据用户ID查询店铺 -->
    <select id="selectShopByUserId" parameterType="Long" resultMap="ShopResult">
        <include refid="selectShopVo"/>
        where user_id = #{userId} and delete_flag = 0
        limit 1
    </select>

    <!-- 新增：增加店铺销量 -->
    <update id="increaseSales">
        UPDATE shop
        SET sales_count = sales_count + #{quantity},
            update_time = NOW()
        WHERE id = #{shopId} AND delete_flag = 0
    </update>

    <!-- 新增：增加店铺粉丝数 -->
    <update id="increaseFollower">
        UPDATE shop
        SET follower_count = follower_count + #{count},
            update_time = NOW()
        WHERE id = #{shopId} AND delete_flag = 0
    </update>

    <!-- 新增：减少店铺粉丝数 -->
    <update id="decreaseFollower">
        UPDATE shop
        SET follower_count = GREATEST(0, follower_count - #{count}),
            update_time = NOW()
        WHERE id = #{shopId} AND delete_flag = 0
    </update>

    <!-- 新增：更新店铺评分 -->
    <update id="updateShopScore">
        UPDATE shop
        SET shop_score = #{score},
            update_time = NOW()
        WHERE id = #{shopId} AND delete_flag = 0
    </update>

    <!-- 新增：更新店铺状态 -->
    <update id="updateShopStatus">
        UPDATE shop
        SET status = #{status},
            update_user = #{updateUser},
            update_time = NOW()
        WHERE id = #{shopId}
    </update>


    <insert id="insertShop" parameterType="Shop" useGeneratedKeys="true" keyProperty="id">
        insert into shop
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createUser != null">create_user,</if>
            <if test="updateUser != null">update_user,</if>
            <if test="deleteFlag != null">delete_flag,</if>
            <if test="userId != null">user_id,</if>
            <if test="shopName != null and shopName != ''">shop_name,</if>
            <if test="shopLogo != null">shop_logo,</if>
            <if test="shopBanner != null">shop_banner,</if>
            <if test="description != null">description,</if>
            <if test="contactPhone != null">contact_phone,</if>
            <if test="contactAddress != null">contact_address,</if>
            <if test="shopScore != null">shop_score,</if>
            <if test="salesCount != null">sales_count,</if>
            <if test="productCount != null">product_count,</if>
            <if test="followerCount != null">follower_count,</if>
            <if test="status != null">status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createUser != null">#{createUser},</if>
            <if test="updateUser != null">#{updateUser},</if>
            <if test="deleteFlag != null">#{deleteFlag},</if>
            <if test="userId != null">#{userId},</if>
            <if test="shopName != null and shopName != ''">#{shopName},</if>
            <if test="shopLogo != null">#{shopLogo},</if>
            <if test="shopBanner != null">#{shopBanner},</if>
            <if test="description != null">#{description},</if>
            <if test="contactPhone != null">#{contactPhone},</if>
            <if test="contactAddress != null">#{contactAddress},</if>
            <if test="shopScore != null">#{shopScore},</if>
            <if test="salesCount != null">#{salesCount},</if>
            <if test="productCount != null">#{productCount},</if>
            <if test="followerCount != null">#{followerCount},</if>
            <if test="status != null">#{status},</if>
         </trim>
    </insert>

    <update id="updateShop" parameterType="Shop">
        update shop
        <trim prefix="SET" suffixOverrides=",">
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createUser != null">create_user = #{createUser},</if>
            <if test="updateUser != null">update_user = #{updateUser},</if>
            <if test="deleteFlag != null">delete_flag = #{deleteFlag},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="shopName != null and shopName != ''">shop_name = #{shopName},</if>
            <if test="shopLogo != null">shop_logo = #{shopLogo},</if>
            <if test="shopBanner != null">shop_banner = #{shopBanner},</if>
            <if test="description != null">description = #{description},</if>
            <if test="contactPhone != null">contact_phone = #{contactPhone},</if>
            <if test="contactAddress != null">contact_address = #{contactAddress},</if>
            <if test="shopScore != null">shop_score = #{shopScore},</if>
            <if test="salesCount != null">sales_count = #{salesCount},</if>
            <if test="productCount != null">product_count = #{productCount},</if>
            <if test="followerCount != null">follower_count = #{followerCount},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where shop.id = #{id}
    </update>

    <delete id="deleteShopById" parameterType="Long">
--         delete from shop where id = #{id}
            UPDATE shop
            SET delete_flag = 1,
                update_time = NOW()
            WHERE id = #{id}
    </delete>

    <delete id="deleteShopByIds" parameterType="String">
        UPDATE shop
        SET delete_flag = 1,
        update_time = NOW()
        WHERE id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 新增：逻辑删除店铺 -->
    <update id="deleteShopLogicById" parameterType="Long">
        UPDATE shop
        SET delete_flag = 1,
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <!-- 新增：批量逻辑删除店铺 -->
    <update id="deleteShopLogicByIds" parameterType="String">
        UPDATE shop
        SET delete_flag = 1,
        update_time = NOW()
        WHERE id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 新增：热门店铺查询 -->
    <select id="selectHotShopList" resultMap="ShopResult">
        <include refid="selectShopVo"/>
        WHERE delete_flag = 0 AND status = 1
        ORDER BY sales_count DESC, follower_count DESC
        LIMIT #{limit}
    </select>

    <!-- 新增：搜索店铺 -->
    <select id="searchShops" parameterType="map" resultMap="ShopResult">
        <include refid="selectShopVo"/>
        <where>
            delete_flag = 0
            <if test="keyword != null and keyword != ''">
                AND (shop_name LIKE CONCAT('%', #{keyword}, '%')
                OR description LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY sales_count DESC, create_time DESC
    </select>
</mapper>