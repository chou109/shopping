<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neuedu.system.mapper.UserFavoriteMapper">
    
    <resultMap type="UserFavorite" id="UserFavoriteResult">
        <result property="favoriteId"    column="favorite_id"    />
        <result property="userId"    column="user_id"    />
        <result property="targetType"    column="target_type"    />
        <result property="targetId"    column="target_id"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <!-- 收藏列表包含商品/店铺详情 -->
    <resultMap type="UserFavorite" id="UserFavoriteWithDetailResult">
        <result property="favoriteId"    column="favorite_id"    />
        <result property="userId"    column="user_id"    />
        <result property="targetType"    column="target_type"    />
        <result property="targetId"    column="target_id"    />
        <result property="createTime"    column="create_time"    />
        <!-- 商品关联字段 -->
        <result property="productName"    column="product_name"    />
        <result property="productMainImage"    column="product_main_image"    />
        <result property="productPrice"    column="product_price"    />
        <result property="productSubtitle"    column="product_subtitle"    />
        <!-- 店铺关联字段 -->
        <result property="shopName"    column="shop_name"    />
        <result property="shopLogo"    column="shop_logo"    />
        <result property="shopFollowers"    column="shop_followers"    />
        <result property="shopRating"    column="shop_rating"    />
    </resultMap>

    <sql id="selectUserFavoriteVo">
        select favorite_id, user_id, target_type, target_id, create_time from user_favorite
    </sql>

    <select id="selectUserFavoriteList" parameterType="UserFavorite" resultMap="UserFavoriteResult">
        <include refid="selectUserFavoriteVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="targetType != null "> and target_type = #{targetType}</if>
            <if test="targetId != null "> and target_id = #{targetId}</if>
        </where>
    </select>
    
    <select id="selectUserFavoriteByFavoriteId" parameterType="Long" resultMap="UserFavoriteResult">
        <include refid="selectUserFavoriteVo"/>
        where user_favorite.favorite_id = #{favoriteId}
    </select>

    <!-- 新增：根据用户ID和收藏目标查询收藏 -->
    <select id="selectByUserAndTarget" resultMap="UserFavoriteResult">
        <include refid="selectUserFavoriteVo"/>
        where user_id = #{userId}
        and target_type = #{targetType}
        and target_id = #{targetId}
        limit 1
    </select>

    <!-- 新增：查询用户的收藏列表（按类型） -->
    <select id="selectUserFavorites" resultMap="UserFavoriteWithDetailResult">
        SELECT uf.favorite_id, uf.user_id, uf.target_type, uf.target_id, uf.create_time,
               p.name as product_name, p.main_image as product_main_image, p.price as product_price, p.sub_title as product_subtitle,
               s.shop_name as shop_name, s.shop_logo as shop_logo, s.follower_count as shop_followers, s.shop_score as shop_rating
        FROM user_favorite uf
        LEFT JOIN product p ON uf.target_type = 1 AND uf.target_id = p.id
        LEFT JOIN shop s ON uf.target_type = 2 AND uf.target_id = s.id
        WHERE uf.user_id = #{userId}
        <if test="targetType != null">
            AND uf.target_type = #{targetType}
        </if>
        ORDER BY uf.create_time DESC
    </select>

    <!-- 新增：检查用户是否已收藏 -->
    <select id="existsFavorite" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM user_favorite
        WHERE user_id = #{userId}
          AND target_type = #{targetType}
          AND target_id = #{targetId}
    </select>

    <!-- 新增：统计用户的收藏数量 -->
    <select id="countUserFavorites" resultType="Long">
        SELECT COUNT(*)
        FROM user_favorite
        WHERE user_id = #{userId}
        <if test="targetType != null">
            AND target_type = #{targetType}
        </if>
    </select>

    <!-- 新增：统计目标的被收藏数量 -->
    <select id="countTargetFavorites" resultType="Long">
        SELECT COUNT(*)
        FROM user_favorite
        WHERE target_type = #{targetType}
          AND target_id = #{targetId}
    </select>


    <insert id="insertUserFavorite" parameterType="UserFavorite" useGeneratedKeys="true" keyProperty="favoriteId">
        insert into user_favorite
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="targetType != null">target_type,</if>
            <if test="targetId != null">target_id,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="targetType != null">#{targetType},</if>
            <if test="targetId != null">#{targetId},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateUserFavorite" parameterType="UserFavorite">
        update user_favorite
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="targetType != null">target_type = #{targetType},</if>
            <if test="targetId != null">target_id = #{targetId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where user_favorite.favorite_id = #{favoriteId}
    </update>

    <delete id="deleteUserFavoriteByFavoriteId" parameterType="Long">
        delete from user_favorite where favorite_id = #{favoriteId}
    </delete>

    <!-- 新增：删除用户的收藏 -->
    <delete id="deleteByUserAndTarget">
        delete from user_favorite
        where user_id = #{userId}
          and target_type = #{targetType}
          and target_id = #{targetId}
    </delete>

    <delete id="deleteUserFavoriteByFavoriteIds" parameterType="String">
        delete from user_favorite where favorite_id in 
        <foreach item="favoriteId" collection="array" open="(" separator="," close=")">
            #{favoriteId}
        </foreach>
    </delete>
</mapper>