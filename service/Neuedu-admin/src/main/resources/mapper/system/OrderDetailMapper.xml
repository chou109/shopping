        <result property="receiveTime"    column="receive_time"    />


        <!-- 关联商品信息 -->
        <association property="product" javaType="Product">
            <id property="id" column="product_id" />
            <result property="name" column="p_name" />
            <result property="subTitle" column="p_sub_title" />
            <result property="mainImage" column="p_main_image" />
            <result property="price" column="p_price" />
            <result property="stock" column="p_stock" />
        </association>

        <!-- 关联活动信息 -->
        <association property="activity" javaType="Activity">
            <id property="id" column="activity_id" />
            <result property="name" column="a_name" />
            <result property="mainImage" column="a_main_image" />
        </association>
    </resultMap>

    <!-- 基础查询SQL，添加关联查询 -->
    <sql id="selectOrderDetailVo">
        select
        od.id,
        od.create_time,
        od.update_time,
        od.create_user,
        od.update_user,
        od.delete_flag,
        od.order_no,
        od.order_detail_no,
        od.activity_id,
        od.activity_name,
        od.activity_main_image,
        od.product_id,
        od.product_name,
        od.product_main_image,
        od.current_unit_price,
        od.quantity,
        od.total_price,
        od.user_id,
        od.status,
        od.status_desc,
        od.cancel_time,
        od.cancel_reason,
        od.send_time,
        od.receive_time,
        <!-- 商品信息 -->
        p.name as p_name,
        p.sub_title as p_sub_title,
        p.main_image as p_main_image,
        p.price as p_price,
        p.stock as p_stock,
        <!-- 活动信息 -->
        a.name as a_name,
        a.main_image as a_main_image
        from order_detail od
        left join product p on od.product_id = p.product_id and p.delete_flag = 0
        left join activity a on od.activity_id = a.activity_id and a.delete_flag = 0
    </sql>

