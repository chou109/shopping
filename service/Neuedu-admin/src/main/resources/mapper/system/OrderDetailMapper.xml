<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neuedu.system.mapper.OrderDetailMapper">
    
    <resultMap type="OrderDetail" id="OrderDetailResult">
        <result property="id"    column="id"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createUser"    column="create_user"    />
        <result property="updateUser"    column="update_user"    />
        <result property="deleteFlag"    column="delete_flag"    />
        <result property="orderNo"    column="order_no"    />
        <result property="orderDetailNo"    column="order_detail_no"    />
        <result property="activityId"    column="activity_id"    />
        <result property="activityName"    column="activity_name"    />
        <result property="activityMainImage"    column="activity_main_image"    />
        <result property="productId"    column="product_id"    />
        <result property="productName"    column="product_name"    />
        <result property="productMainImage"    column="product_main_image"    />
        <result property="currentUnitPrice"    column="current_unit_price"    />
        <result property="quantity"    column="quantity"    />
        <result property="totalPrice"    column="total_price"    />
        <result property="userId"    column="user_id"    />
        <result property="status"    column="status"    />
        <result property="statusDesc"    column="status_desc"    />
        <result property="cancelTime"    column="cancel_time"    />
        <result property="cancelReason"    column="cancel_reason"    />
        <result property="sendTime"    column="send_time"    />
        <result property="receiveTime"    column="receive_time"    />
    </resultMap>

    <sql id="selectOrderDetailVo">
        select id, create_time, update_time, create_user, update_user, delete_flag, order_no, order_detail_no, activity_id, activity_name, activity_main_image, product_id, product_name, product_main_image, current_unit_price, quantity, total_price, user_id, status, status_desc, cancel_time, cancel_reason, send_time, receive_time from order_detail
    </sql>

    <select id="selectOrderDetailList" parameterType="OrderDetail" resultMap="OrderDetailResult">
        <include refid="selectOrderDetailVo"/>
        <where>  
            <if test="createUser != null "> and create_user = #{createUser}</if>
            <if test="updateUser != null "> and update_user = #{updateUser}</if>
            <if test="deleteFlag != null "> and delete_flag = #{deleteFlag}</if>
            <if test="orderNo != null  and orderNo != ''"> and order_no = #{orderNo}</if>
            <if test="orderDetailNo != null  and orderDetailNo != ''"> and order_detail_no = #{orderDetailNo}</if>
            <if test="activityId != null "> and activity_id = #{activityId}</if>
            <if test="activityName != null  and activityName != ''"> and activity_name like concat('%', #{activityName}, '%')</if>
            <if test="activityMainImage != null  and activityMainImage != ''"> and activity_main_image = #{activityMainImage}</if>
            <if test="productId != null "> and product_id = #{productId}</if>
            <if test="productName != null  and productName != ''"> and product_name like concat('%', #{productName}, '%')</if>
            <if test="productMainImage != null  and productMainImage != ''"> and product_main_image = #{productMainImage}</if>
            <if test="currentUnitPrice != null "> and current_unit_price = #{currentUnitPrice}</if>
            <if test="quantity != null "> and quantity = #{quantity}</if>
            <if test="totalPrice != null "> and total_price = #{totalPrice}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="statusDesc != null  and statusDesc != ''"> and status_desc = #{statusDesc}</if>
            <if test="cancelTime != null "> and cancel_time = #{cancelTime}</if>
            <if test="cancelReason != null "> and cancel_reason = #{cancelReason}</if>
            <if test="sendTime != null "> and send_time = #{sendTime}</if>
            <if test="receiveTime != null "> and receive_time = #{receiveTime}</if>
        </where>
    </select>
    
    <select id="selectOrderDetailById" parameterType="Long" resultMap="OrderDetailResult">
        <include refid="selectOrderDetailVo"/>
        where order_detail.id = #{id}
    </select>
        
    <insert id="insertOrderDetail" parameterType="OrderDetail" useGeneratedKeys="true" keyProperty="id">
        insert into order_detail
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createUser != null">create_user,</if>
            <if test="updateUser != null">update_user,</if>
            <if test="deleteFlag != null">delete_flag,</if>
            <if test="orderNo != null and orderNo != ''">order_no,</if>
            <if test="orderDetailNo != null and orderDetailNo != ''">order_detail_no,</if>
            <if test="activityId != null">activity_id,</if>
            <if test="activityName != null">activity_name,</if>
            <if test="activityMainImage != null">activity_main_image,</if>
            <if test="productId != null">product_id,</if>
            <if test="productName != null and productName != ''">product_name,</if>
            <if test="productMainImage != null and productMainImage != ''">product_main_image,</if>
            <if test="currentUnitPrice != null">current_unit_price,</if>
            <if test="quantity != null">quantity,</if>
            <if test="totalPrice != null">total_price,</if>
            <if test="userId != null">user_id,</if>
            <if test="status != null">status,</if>
            <if test="statusDesc != null">status_desc,</if>
            <if test="cancelTime != null">cancel_time,</if>
            <if test="cancelReason != null">cancel_reason,</if>
            <if test="sendTime != null">send_time,</if>
            <if test="receiveTime != null">receive_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createUser != null">#{createUser},</if>
            <if test="updateUser != null">#{updateUser},</if>
            <if test="deleteFlag != null">#{deleteFlag},</if>
            <if test="orderNo != null and orderNo != ''">#{orderNo},</if>
            <if test="orderDetailNo != null and orderDetailNo != ''">#{orderDetailNo},</if>
            <if test="activityId != null">#{activityId},</if>
            <if test="activityName != null">#{activityName},</if>
            <if test="activityMainImage != null">#{activityMainImage},</if>
            <if test="productId != null">#{productId},</if>
            <if test="productName != null and productName != ''">#{productName},</if>
            <if test="productMainImage != null and productMainImage != ''">#{productMainImage},</if>
            <if test="currentUnitPrice != null">#{currentUnitPrice},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="totalPrice != null">#{totalPrice},</if>
            <if test="userId != null">#{userId},</if>
            <if test="status != null">#{status},</if>
            <if test="statusDesc != null">#{statusDesc},</if>
            <if test="cancelTime != null">#{cancelTime},</if>
            <if test="cancelReason != null">#{cancelReason},</if>
            <if test="sendTime != null">#{sendTime},</if>
            <if test="receiveTime != null">#{receiveTime},</if>
         </trim>
    </insert>

    <update id="updateOrderDetail" parameterType="OrderDetail">
        update order_detail
        <trim prefix="SET" suffixOverrides=",">
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createUser != null">create_user = #{createUser},</if>
            <if test="updateUser != null">update_user = #{updateUser},</if>
            <if test="deleteFlag != null">delete_flag = #{deleteFlag},</if>
            <if test="orderNo != null and orderNo != ''">order_no = #{orderNo},</if>
            <if test="orderDetailNo != null and orderDetailNo != ''">order_detail_no = #{orderDetailNo},</if>
            <if test="activityId != null">activity_id = #{activityId},</if>
            <if test="activityName != null">activity_name = #{activityName},</if>
            <if test="activityMainImage != null">activity_main_image = #{activityMainImage},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="productName != null and productName != ''">product_name = #{productName},</if>
            <if test="productMainImage != null and productMainImage != ''">product_main_image = #{productMainImage},</if>
            <if test="currentUnitPrice != null">current_unit_price = #{currentUnitPrice},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="totalPrice != null">total_price = #{totalPrice},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="statusDesc != null">status_desc = #{statusDesc},</if>
            <if test="cancelTime != null">cancel_time = #{cancelTime},</if>
            <if test="cancelReason != null">cancel_reason = #{cancelReason},</if>
            <if test="sendTime != null">send_time = #{sendTime},</if>
            <if test="receiveTime != null">receive_time = #{receiveTime},</if>
        </trim>
        where order_detail.id = #{id}
    </update>

    <delete id="deleteOrderDetailById" parameterType="Long">
        delete from order_detail where id = #{id}
    </delete>

    <delete id="deleteOrderDetailByIds" parameterType="String">
        delete from order_detail where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>