<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neuedu.system.mapper.RechargeInfoMapper">
    
    <resultMap type="RechargeInfo" id="RechargeInfoResult">
        <result property="id"    column="id"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="userId"    column="user_id"    />
        <result property="balance"    column="balance"    />
        <result property="orderId"    column="order_id"    />
        <result property="orderNo"    column="order_no"    />
    </resultMap>

    <sql id="selectRechargeInfoVo">
        select id, create_time, update_time, user_id, balance, order_id, order_no from recharge_info
    </sql>

    <select id="selectRechargeInfoList" parameterType="RechargeInfo" resultMap="RechargeInfoResult">
        <include refid="selectRechargeInfoVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="balance != null "> and balance = #{balance}</if>
            <if test="orderId != null "> and order_id = #{orderId}</if>
            <if test="orderNo != null  and orderNo != ''"> and order_no = #{orderNo}</if>
        </where>
    </select>
    
    <select id="selectRechargeInfoById" parameterType="Long" resultMap="RechargeInfoResult">
        <include refid="selectRechargeInfoVo"/>
        where recharge_info.id = #{id}
    </select>
        
    <insert id="insertRechargeInfo" parameterType="RechargeInfo" useGeneratedKeys="true" keyProperty="id">
        insert into recharge_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="userId != null">user_id,</if>
            <if test="balance != null">balance,</if>
            <if test="orderId != null">order_id,</if>
            <if test="orderNo != null">order_no,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="userId != null">#{userId},</if>
            <if test="balance != null">#{balance},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="orderNo != null">#{orderNo},</if>
         </trim>
    </insert>

    <update id="updateRechargeInfo" parameterType="RechargeInfo">
        update recharge_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="balance != null">balance = #{balance},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
        </trim>
        where recharge_info.id = #{id}
    </update>

    <delete id="deleteRechargeInfoById" parameterType="Long">
        delete from recharge_info where id = #{id}
    </delete>

    <delete id="deleteRechargeInfoByIds" parameterType="String">
        delete from recharge_info where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>