    <select id="selectUserAddressList" parameterType="com.neuedu.system.domain.UserAddress" resultMap="UserAddressResult">
        <include refid="selectUserAddressVo"/>
        <where>
            delete_flag = 0
            <if test="userId != null"> and user_id = #{userId}</if>
            <if test="defaultFlag != null"> and default_flag = #{defaultFlag}</if>
            <if test="receiveName != null and receiveName != ''"> and receive_name like concat('%', #{receiveName}, '%')</if>
            <if test="receivePhone != null and receivePhone != ''"> and receive_phone = #{receivePhone}</if>
            <if test="province != null and province != ''"> and province = #{province}</if>
            <if test="city != null and city != ''"> and city = #{city}</if>
            <if test="area != null and area != ''"> and area = #{area}</if>
        </where>
        order by default_flag desc, create_time desc
    </select>
    
    <select id="selectUserAddressById" parameterType="Long" resultMap="UserAddressResult">
        <include refid="selectUserAddressVo"/>
        where user_address.id = #{id} and delete_flag = 0
    </select>

    <select id="selectUserAddressByAddressId" parameterType="Long" resultMap="UserAddressResult">
        <include refid="selectUserAddressVo"/>
        where address_id = #{addressId} and delete_flag = 0
    </select>

    <select id="selectDefaultAddressByUserId" parameterType="Long" resultMap="UserAddressResult">
        <include refid="selectUserAddressVo"/>
        where user_id = #{userId} and default_flag = 1 and delete_flag = 0
        limit 1
    </select>
        
    <insert id="insertUserAddress" parameterType="UserAddress" useGeneratedKeys="true" keyProperty="id">
        insert into user_address
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="addressId != null">address_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createUser != null">create_user,</if>
            <if test="updateUser != null">update_user,</if>
            <if test="deleteFlag != null">delete_flag,</if>
            <if test="defaultFlag != null">default_flag,</if>
            <if test="receiveName != null and receiveName != ''">receive_name,</if>
            <if test="receivePhone != null and receivePhone != ''">receive_phone,</if>
            <if test="province != null and province != ''">province,</if>
            <if test="provinceCode != null and provinceCode != ''">province_code,</if>
            <if test="city != null and city != ''">city,</if>
            <if test="cityCode != null and cityCode != ''">city_code,</if>
            <if test="area != null and area != ''">area,</if>
            <if test="areaCode != null and areaCode != ''">area_code,</if>
            <if test="street != null">street,</if>
            <if test="postalCode != null">postal_code,</if>
            <if test="addressLabel != null">address_label,</if>
            <if test="userId != null">user_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="addressId != null">#{addressId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createUser != null">#{createUser},</if>
            <if test="updateUser != null">#{updateUser},</if>
            <if test="deleteFlag != null">#{deleteFlag},</if>
            <if test="defaultFlag != null">#{defaultFlag},</if>
            <if test="receiveName != null and receiveName != ''">#{receiveName},</if>
            <if test="receivePhone != null and receivePhone != ''">#{receivePhone},</if>
            <if test="province != null and province != ''">#{province},</if>
            <if test="provinceCode != null and provinceCode != ''">#{provinceCode},</if>
            <if test="city != null and city != ''">#{city},</if>
            <if test="cityCode != null and cityCode != ''">#{cityCode},</if>
            <if test="area != null and area != ''">#{area},</if>
            <if test="areaCode != null and areaCode != ''">#{areaCode},</if>
            <if test="street != null">#{street},</if>
            <if test="postalCode != null">#{postalCode},</if>
            <if test="addressLabel != null">#{addressLabel},</if>
            <if test="userId != null">#{userId},</if>
         </trim>
    </insert>

    <update id="updateUserAddress" parameterType="UserAddress">
        update user_address
        <trim prefix="SET" suffixOverrides=",">
            <if test="addressId != null">address_id = #{addressId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createUser != null">create_user = #{createUser},</if>
            <if test="updateUser != null">update_user = #{updateUser},</if>
            <if test="deleteFlag != null">delete_flag = #{deleteFlag},</if>
            <if test="defaultFlag != null">default_flag = #{defaultFlag},</if>
            <if test="receiveName != null and receiveName != ''">receive_name = #{receiveName},</if>
            <if test="receivePhone != null and receivePhone != ''">receive_phone = #{receivePhone},</if>
            <if test="province != null and province != ''">province = #{province},</if>
            <if test="provinceCode != null and provinceCode != ''">province_code = #{provinceCode},</if>
            <if test="city != null and city != ''">city = #{city},</if>
            <if test="cityCode != null and cityCode != ''">city_code = #{cityCode},</if>
            <if test="area != null and area != ''">area = #{area},</if>
            <if test="areaCode != null and areaCode != ''">area_code = #{areaCode},</if>
            <if test="street != null">street = #{street},</if>
            <if test="postalCode != null">postal_code = #{postalCode},</if>
            <if test="addressLabel != null">address_label = #{addressLabel},</if>
        </trim>
        where user_address.id = #{id} and delete_flag = 0
    </update>

    <!-- 取消所有默认地址 -->
    <update id="cancelAllDefaultAddress" parameterType="Long">
        update user_address
        set default_flag = 0, update_time = now()
        where user_id = #{userId} and default_flag = 1 and delete_flag = 0
    </update>

    <!-- 设置默认地址 -->
    <update id="setDefaultAddress">
        update user_address
        set default_flag = 1, update_time = now()
        where address_id = #{addressId} and user_id = #{userId} and delete_flag = 0
    </update>

    <!-- 软删除 -->
    <update id="deleteUserAddressById" parameterType="Long">
        update user_address set delete_flag = 1, update_time = now() where id = #{id}
    </update>

    <update id="deleteUserAddressByIds" parameterType="Long[]">
        update user_address set delete_flag = 1,update_time = now() where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>