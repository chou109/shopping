    </resultMap>

    <sql id="selectRefundRecordVo">
        select id, create_time, update_time, create_user, update_user, delete_flag, refund_no, order_no, user_id, refund_amount, refund_status, refund_status_desc, refund_reason, audit_opinion, refund_type, refund_time from refund_record
