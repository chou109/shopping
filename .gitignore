# 依赖 / 构建产物
node_modules/
vendor/
dist/
dist-ssr/
.vite/

# 环境变量（含数据库密码、JWT 密钥，切勿提交）
.env
.env.backup
.env.*.local

# Laravel 运行时文件
laravelY/.env
laravelY/storage/*.key
laravelY/storage/logs/*.log
laravelY/public/storage
laravelY/public/hot
laravelY/bootstrap/cache/*
!laravelY/bootstrap/cache/.gitignore

# 编辑器 / 操作系统
.idea/
*.suo
*.sw?
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*
yarn-error.log*
